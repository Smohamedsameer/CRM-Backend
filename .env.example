# Copy this file to .env (or set these as real environment variables / secrets
# in your hosting platform) and NEVER commit the filled-in .env file.

# ---------------- Server ----------------
PORT=8080

# ---------------- Database ----------------
DB_URL=jdbc:mysql://localhost:3306/lead_quote_system
DB_USERNAME=root
DB_PASSWORD=change_me

# ---------------- Auth ----------------
# Generate with: openssl rand -base64 32
JWT_SECRET=change_me_to_a_long_random_base64_secret_at_least_32_bytes
JWT_EXPIRATION_MS=86400000

# ---------------- WhatsApp Business Platform (Cloud API) ----------------
WHATSAPP_ACCESS_TOKEN=change_me
WHATSAPP_PHONE_NUMBER_ID=change_me
WHATSAPP_BUSINESS_ACCOUNT_ID=change_me
WHATSAPP_API_VERSION=v20.0
# Any random string you also enter in the Meta App webhook configuration screen
WHATSAPP_WEBHOOK_VERIFY_TOKEN=change_me_webhook_verify_token

# ---------------- Email (used for internal notifications / backup channel) ----------------
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USERNAME=change_me@example.com
EMAIL_PASSWORD=change_me_app_password

# ---------------- Company profile (shown on quotations / messages) ----------------
COMPANY_NAME=Your Company Pvt Ltd
COMPANY_PHONE=+91 00000 00000
COMPANY_EMAIL=sales@company.com
COMPANY_ADDRESS=Your Company Address, City, State, PIN
COMPANY_GST_NUMBER=
COMPANY_LOGO_PATH=
# Public URL of the deployed frontend - used to build enquiry/quotation links sent over WhatsApp
PUBLIC_BASE_URL=https://yourdomain.com

# ---------------- App behaviour ----------------
PDF_STORAGE_DIR=./storage/quotations
ENQUIRY_TOKEN_VALIDITY_HOURS=168
QUOTATION_VALIDITY_DAYS=15

# ---------------- Pricing rules (configurable, not hard-coded) ----------------
PRICE_RATE_PER_SQFT=20.00
PRICE_ADDITIONAL_CHARGES=0.00
PRICE_DEFAULT_DISCOUNT_PCT=0.00
PRICE_DEFAULT_TAX_PCT=18.00
